---
import { site } from '../data/site';
interface Props { backLink?: boolean }
const { backLink = false } = Astro.props;
---

<header>
  <nav class="wrap" aria-label="Primary">
    <a class="name" href="/">{site.name}</a>
    {backLink ? (
      <a class="links back" href="/#work">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 8H3M7 4L3 8l4 4" /></svg>
        All case studies
      </a>
    ) : (
      <div class="links">
        <a href="/#how">How I work</a>
        <a href="/#work">Work</a>
        <a href="/#background">Background</a>
        <a href="/#contact">Connect</a>
      </div>
    )}
  </nav>
</header>

<style>
  header { border-bottom: 1px solid var(--rule); }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    padding-block: 12px;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 21px;
    text-decoration: none;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 28px;
    font-size: 16px;
    font-weight: 500;
  }
  .links a, a.back { white-space: nowrap; text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  a.back { gap: 8px; }
  @media (max-width: 640px) {
    nav { flex-direction: column; align-items: flex-start; gap: 0; }
    .name { min-height: 40px; display: inline-flex; align-items: center; }
    .links { gap: 0 14px; font-size: 15px; flex-wrap: nowrap; }
  }
</style>
