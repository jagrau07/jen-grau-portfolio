---
// Use inside a case study .mdx file:
// <Decision heading="Why a CLI and not an automated job" obvious="..." instead="...">
//   Paragraph explaining the reasoning.
// </Decision>
interface Props {
  heading: string;
  obvious: string;
  instead: string;
}
const { heading, obvious, instead } = Astro.props;
const id = 'decision-' + heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<section class="decision" aria-labelledby={id}>
  <div class="head">
    <h2 id={id}>The decision</h2>
    <span>{heading}</span>
  </div>
  <div class="split">
    <div class="obvious">
      <span class="tag">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4l8 8M12 4l-8 8" /></svg>
        The obvious move
      </span>
      <p>{obvious}</p>
    </div>
    <div class="instead">
      <span class="tag">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3.2 3L13 4.5" /></svg>
        What I did instead
      </span>
      <p>{instead}</p>
    </div>
  </div>
  <div class="why">
    <slot />
  </div>
</section>

<style>
  .decision {
    border: 1.5px solid var(--plum);
    border-radius: 16px;
    overflow: hidden;
    background: var(--paper);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 16px;
    padding: 20px 26px;
    background: var(--plum);
    color: var(--on-dark);
  }
  .head span { font-size: 16px; font-weight: 700; color: var(--rose); }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.3;
    color: var(--on-dark);
  }
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  }
  .split > div { padding: 28px 26px; display: flex; flex-direction: column; gap: 10px; }
  .obvious { background: var(--band); }
  .tag { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 700; }
  .obvious .tag, .obvious p { color: var(--muted); }
  .instead .tag { color: var(--pink-text); }
  .split p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.4;
  }
  .why {
    padding: 26px;
    border-top: 1px solid var(--rule);
    font-size: 18px;
    line-height: 1.75;
    color: var(--body);
  }
  .why :global(p) { margin: 0 0 1em; }
  .why :global(p:last-child) { margin-bottom: 0; }
</style>
