---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const studies = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const tags = [
  'Executive Partnership',
  'Engineering Operations',
  'Technical Program Leadership',
  'Enterprise Architecture',
  'AI-Enabled Tooling',
];

const roles = [
  'Developer',
  'Business analyst',
  'Enterprise architect',
  'People manager',
  'Program manager',
  'Compliance owner',
];

const principles = [
  {
    title: 'I build for the handoff.',
    body: 'I document up front and build so nothing assumes I’ll always be the one running it. A project has a start and an end, and the work should transition to the people who operate it. That’s what frees me to go do the next thing.',
  },
  {
    title: 'I keep a human in the loop where judgment belongs.',
    body: 'AI widens what I can research, compare and flag. It doesn’t decide which of five findings matters, or where the real decision is hiding. That judgment is what turns capability into a result.',
  },
  {
    title: 'I work in the seams.',
    body: 'I’ve sat on several sides of the same table. The costly problems are the ones each group reasonably assumes someone else has. I’ve done enough of each job to know what each side is likely to miss.',
  },
];

const timeline = [
  {
    when: '2021 to now',
    what: 'Higher-ed SaaS · Senior Program Manager',
    detail: 'GRC and compliance (SOC 2 Type II, TX-RAMP, HECVAT), technical program management, and operational process work for a higher-ed SaaS company.',
  },
  {
    when: '20+ years',
    what: 'UC San Diego · Developer to program manager',
    detail: 'Central IT for a major research university with an academic medical center, across six business domains. Java middleware for SSO and mainframe integration; business analysis on procurement data flows; then led teams through replacing mainframes with new enterprise systems, including PeopleSoft integrations and the payroll ledger.',
  },
  {
    when: 'Degree',
    what: 'MAS, Convergent Systems Engineering',
    detail: 'UC San Diego Jacobs School of Engineering, Architecture-Based Enterprise Systems Engineering specialization. Coursework included Complexity and Large Scale Systems, Enterprise Architecting, Engineering Essentials for Open Distributed Systems, and Patterns for Enterprise Architecting.',
    link: { href: 'https://jacobsschool.ucsd.edu/mas/cose', text: 'Read about the program.' },
  },
  {
    when: 'Volunteer',
    what: 'Daughters of the American Revolution',
    detail: 'Volunteer Information Specialist Chair at the California state level: websites, DNS and Microsoft 365 for roughly two hundred chapters.',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="hero blueprint">
    <div class="wrap hero__inner">
      <p class="label hero__tags">{tags.map((t, i) => <span>{t}{i < tags.length - 1 ? ' ·' : ''}</span>)}</p>
      <div class="hero__copy">
        <h1 class="display">
          The expensive problems fall between specialties. <span class="mark">That’s where I work.</span>
        </h1>
        <p class="lede">
          I’m a technical program leader with the depth to read the code, design the system and write it. Every few
          years the tools turn over, and I go after each one, learning what it can actually do and making it fit the
          work in front of me. Right now that’s AI. I tend to go first into the part nobody has mapped yet, then
          bring people in behind me.
        </p>
        <div class="actions">
          <a class="btn btn--primary" href="#work">
            View my work
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
          </a>
          <a class="btn" href={site.linkedin} rel="me">LinkedIn</a>
        </div>
      </div>

      <aside class="roles" aria-label="Roles held">
        <div class="roles__head">Seats I’ve sat in</div>
        <ol>
          {roles.map((r) => <li>{r}</li>)}
        </ol>
      </aside>
    </div>
  </section>

  <!-- How I work -->
  <section id="how" class="band">
    <div class="wrap stack">
      <div class="section-head">
        <h2 class="display h2">How I work</h2>
        <p class="label">Three things show up in everything below</p>
      </div>
      <div class="principles">
        {principles.map((p) => (
          <article>
            <h3 class="display">{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Case studies -->
  <section id="work" class="band">
    <div class="wrap stack">
      <div class="intro">
        <h2 class="display h2">Case studies</h2>
        <p>
          Each one follows the same shape: the situation, what I decided, why that instead of the obvious
          alternative, what changed, and what I’d do differently.
        </p>
      </div>
      <ol class="studies">
        {studies.map((s) => (
          <li>
            <a href={`/work/${s.id}/`}>
              <div class="main">
                <span class="label">{s.data.context}</span>
                <span class="title display">{s.data.title}</span>
                <span class="summary">{s.data.summary}</span>
              </div>
              <div class="call">
                <span><span class="call__label">The call</span>{s.data.call}</span>
                <svg class="arrow" aria-hidden="true" width="22" height="22" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Background -->
  <section id="background" class="dark">
    <div class="wrap bg">
      <div class="bg__intro">
        <h2 class="display h2">Background</h2>
        <p>
          <strong class="bg__lead">Two decades in central IT at UC San Diego.</strong> A major research university with a
          medical center, where I worked across six different business domains and learned systems from the code up. Since then, I’ve owned compliance and run
          technical programs for a higher-ed SaaS company. Outside work, I volunteer the same skills for a
          statewide nonprofit.
        </p>
      </div>
      <ol class="timeline">
        {timeline.map((t) => (
          <li>
            <span class="when">{t.when}</span>
            <div>
              <span class="what display">{t.what}</span>
              <span class="detail">
                {t.detail}
                {t.link && (
                  <>
                    {' '}
                    <a href={t.link.href} target="_blank" rel="noopener">
                      {t.link.text}<span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  </>
                )}
              </span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Connect (no email or phone on purpose) -->
  <section id="contact">
    <div class="wrap contact">
      <h2 class="display">If your hardest problem is the one nobody owns, let’s talk.</h2>
      <p>The best way to reach me is a message on LinkedIn.</p>
      <div class="actions">
        <a class="btn btn--primary" href={site.linkedin} rel="me">Message me on LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .band { border-bottom: 1px solid var(--rule); }
  .stack { padding-block: 96px; display: flex; flex-direction: column; gap: 44px; }
  .h2 { margin: 0; font-size: clamp(32px, 3.8vw, 42px); line-height: 1.15; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }

  /* Hero */
  .hero { border-bottom: 1px solid var(--rule); }
  .hero__inner {
    padding-block: 104px 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 30px 56px;
    align-items: flex-end;
  }
  .hero__tags { flex: 1 1 100%; margin: 0; font-size: 16px; display: flex; flex-wrap: wrap; gap: 0 0.4em; }
  .hero__tags span { white-space: nowrap; }
  .hero__copy { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 30px; }
  h1 { margin: 0; font-size: clamp(38px, 5.6vw, 76px); line-height: 1.12; }
  .mark {
    color: var(--violet);
    text-decoration: underline;
    text-decoration-color: var(--pink);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.16em;
    text-decoration-skip-ink: none;
  }
  .lede { margin: 0; max-width: 640px; font-size: 20px; line-height: 1.7; color: var(--body); }
  .hero .actions { padding-top: 6px; }

  .roles { flex: 1 1 280px; min-width: 0; border: 1.5px solid var(--plum); border-radius: var(--radius); overflow: hidden; background: var(--paper); }
  .roles__head { display: flex; justify-content: space-between; gap: 12px; padding: 14px 20px; border-bottom: 1.5px solid var(--plum); font-size: 15px; font-weight: 700; }
  .roles ol { list-style: none; margin: 0; padding: 6px 20px 12px; font-size: 16px; line-height: 1.3; }
  .roles li { padding: 10px 0; border-bottom: 1px solid var(--grid); }
  .roles li:last-child { border-bottom: 0; }

  @media (max-width: 640px) {
    .hero__inner { padding-block: 64px 56px; gap: 40px; }
    .lede { font-size: 18px; }
  }

  /* Principles */
  .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px; }
  .section-head .label { margin: 0; font-size: 16px; }
  .principles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 24px; }
  .principles article {
    padding: 28px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .principles h3 { margin: 0; font-size: 24px; line-height: 1.25; }
  .principles p { margin: 0; font-size: 17px; color: var(--body); }

  /* Studies */
  .intro { display: flex; flex-direction: column; gap: 14px; max-width: 720px; }
  .intro p { margin: 0; font-size: 19px; color: var(--body); }
  .studies { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--plum); }
  .studies li { border-bottom: 1px solid var(--rule); }
  .studies a {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 14px 32px;
    padding: 30px 12px;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.15s ease;
  }
  .studies a:hover { background: var(--band); }
  .studies .main { flex: 999 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .studies .title { font-size: clamp(22px, 2.4vw, 27px); line-height: 1.25; }
  .studies a:hover .title { color: var(--violet); }
  .studies .summary { font-size: 17px; color: var(--body); max-width: 640px; }
  .studies .call {
    flex: 1 1 260px;
    min-width: 0;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 4px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--body);
  }
  .call__label { display: block; font-size: 14px; font-weight: 700; color: var(--pink-text); margin-bottom: 4px; }
  .arrow { flex: 0 0 auto; margin-top: 2px; transition: transform 0.15s ease; }
  .studies a:hover .arrow { transform: translateX(4px); }
  @media (max-width: 640px) {
    .studies a { padding-inline: 0; }
  }

  /* Background */
  .dark { background: var(--plum); color: var(--on-dark); }
  .bg { padding-block: 96px; display: flex; flex-wrap: wrap; gap: 56px; }
  .bg__intro { flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .bg__intro p { margin: 0; color: var(--on-dark-muted); }
  .bg__lead { display: block; margin-bottom: 4px; font-family: var(--font-display); font-size: 24px; font-weight: 600; line-height: 1.3; color: var(--on-dark); }
  .timeline { flex: 999 1 560px; min-width: 0; list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--dark-rule); }
  .timeline li { display: flex; flex-wrap: wrap; gap: 6px 32px; padding: 24px 0; border-bottom: 1px solid var(--dark-rule); }
  .when { flex: 0 0 140px; font-size: 16px; font-weight: 700; color: var(--rose); padding-top: 3px; }
  .timeline div { flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .what { font-size: 21px; line-height: 1.3; }
  .detail a { color: var(--on-dark); text-decoration-color: var(--rose); text-underline-offset: 3px; }
  .detail a:hover { color: var(--rose); }
  .detail { font-size: 16px; color: var(--on-dark-muted); }

  /* Connect */
  .contact { padding-block: 96px 64px; display: flex; flex-direction: column; gap: 24px; }
  .contact h2 { margin: 0; max-width: 820px; font-size: clamp(30px, 4vw, 52px); line-height: 1.15; }
  .contact p { margin: 0; color: var(--body); }
</style>
