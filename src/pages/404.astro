---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="blueprint">
    <div class="wrap" style="padding-block: 120px; display: flex; flex-direction: column; gap: 24px;">
      <p class="label">404</p>
      <h1 class="display" style="margin: 0; font-size: clamp(40px, 6vw, 72px); line-height: 1;">This page fell through a seam.</h1>
      <p><a class="btn btn--primary" href="/">Back to the start</a></p>
    </div>
  </section>
</Base>
